# Optional: receive claim leads by email (Resend)
# Use plain emails in Railway (no display-name <brackets> — they break env parsing).
RESEND_API_KEY=
CLAIM_NOTIFY_TO=you@example.com
CLAIM_NOTIFY_FROM=onboarding@resend.dev

# Optional: forward claim leads to Zapier / Make / n8n / Slack webhook
CLAIM_WEBHOOK_URL=
