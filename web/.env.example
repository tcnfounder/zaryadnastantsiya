# Optional: receive claim leads by email (Resend)
# Use plain emails in Railway (no display-name <brackets> — they break env parsing).
RESEND_API_KEY=
CLAIM_NOTIFY_TO=you@example.com
CLAIM_NOTIFY_FROM=info@zaryadnastantsiya.com.ua
# Optional override for installer auto-reply From (defaults to salesEmail)
# CLAIM_APPLICANT_FROM=info@zaryadnastantsiya.com.ua

# Optional: Monobank jar / WayForPay / LiqPay link shown after claim + in auto-reply
CLAIM_PAY_URL=
NEXT_PUBLIC_CLAIM_PAY_URL=
# Optional: Telegram for fast close
CLAIM_TELEGRAM_URL=
NEXT_PUBLIC_CLAIM_TELEGRAM_URL=

# Optional: forward claim leads to Zapier / Make / n8n / Slack webhook
CLAIM_WEBHOOK_URL=

# Optional: Google Analytics 4 (public — safe in client bundle)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
